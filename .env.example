# LLM provider: mock (default, offline, deterministic) | openai | groq | ollama
SELFHEAL_PROVIDER=mock
# OpenAI-compatible settings (only needed for non-mock providers)
SELFHEAL_MODEL=
SELFHEAL_BASE_URL=
SELFHEAL_API_KEY=
SELFHEAL_TIMEOUT_SECONDS=20

# --- HTTP service (selfheal serve) ---
# Comma-separated API keys. Operators start/follow runs; approvers also decide protected actions.
SELFHEAL_API_KEYS=
SELFHEAL_APPROVER_KEYS=
# Dev mode: no auth (localhost only). Ignored when API keys are set.
SELFHEAL_DEV_MODE=false
# CORS allow-list (comma-separated origins). Empty = same-origin only.
SELFHEAL_CORS_ORIGINS=
# Sliding-window rate limits per caller (API key fingerprint or client IP).
SELFHEAL_RATE_LIMIT_PER_MINUTE=120
SELFHEAL_RUN_LIMIT_PER_MINUTE=6
# Worker pool / queue bounds for background runs.
SELFHEAL_MAX_CONCURRENT_RUNS=2
SELFHEAL_MAX_QUEUED_RUNS=8
SELFHEAL_MAX_RUNS_KEPT=200
# Cap on requested simulated minutes per run.
SELFHEAL_MAX_TICKS_CAP=120
# Trust right-most X-Forwarded-For hop (enable only behind a known reverse proxy).
SELFHEAL_TRUST_PROXY=false
# Run scenarios inside POST /api/runs (auto-on for Vercel / AWS Lambda).
SELFHEAL_SYNC_RUNS=false

# docker compose host port mapping (compose only; not read by the app)
# docker compose host port (compose only): SELFHEAL_HOST_PORT=8000
